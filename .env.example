QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
COLLECTION_NAME=ecommerce_products
GROQ_API_KEY=your_groq_api_key_here
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional — leave blank to disable auth (fine for local dev).
# If set, every /api/v1 request needs a matching X-API-Key header.
API_KEY=
RATE_LIMIT_PER_MINUTE=30

# Only needed by the frontend/eval script when API_KEY above is set.
BACKEND_API_KEY=

# ── Observability ──────────────────────────────────────────
ENVIRONMENT=local

# ── Cache versioning ───────────────────────────────────────
# Bump CATALOG_VERSION whenever data/raw is re-ingested with a different
# catalog so old cached answers (about the old catalog) can never be
# served after the switch. See src/backend/services/cache.py.
CATALOG_VERSION=baseline-39
PROMPT_VERSION=v1
MODEL_VERSION=llama-3.1-8b-instant

# ── LangSmith (https://smith.langchain.com) ────────────────
# Disabled by default. Set LANGSMITH_TRACING=true and provide a real
# LANGSMITH_API_KEY to start tracing the RAG pipeline. The app works
# identically either way — tracing is purely observational.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ecommerce-rag-engine
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
